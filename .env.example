# LLM API Keys (at least one required for generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Default model (overrides built-in default, can still be overridden via --model flag)
# Options:
#   anthropic/claude-sonnet-4-20250514  (default - balanced quality/cost)
#   anthropic/claude-3-haiku-20240307   (faster/cheaper)
#   anthropic/claude-opus-4-20250514    (highest quality)
#   openai/gpt-4o                       (OpenAI)
#   openai/gpt-4o-mini                  (OpenAI cheaper)
GAMEGRAMMAR_MODEL=anthropic/claude-3-haiku-20240307

# BoardGameGeek API Token (required for RAG data collection)
# Register at: https://boardgamegeek.com/applications
# 1. Create a "Non-commercial" application
# 2. Wait for approval (may take up to a week)
# 3. Get your token from the Tokens section
# BGG_API_TOKEN=your_bgg_api_token_here
